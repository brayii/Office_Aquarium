{
  "framework_version": "0.1.0",
  "schema_version": 1,
  "random_seed": 1729,
  "database": ".project-learning/data/learning.db",
  "lifecycle": {
    "reevaluate_every_new_tasks": 10,
    "min_tasks_for_tfidf": 10,
    "min_tasks_for_supervised_model": 30,
    "min_positive_examples_per_class": 5
  },
  "promotion": {
    "primary_metric": "recall_at_5",
    "minimum_relative_improvement": 0.02,
    "secondary_regression_tolerance": 0.03,
    "minimum_eval_examples": 5
  },
  "retrieval": {
    "max_memory_results": 8,
    "max_file_results": 12
  }
}
